[Unit]
Description=Pi Assistant Queue Worker
After=network.target redis-server.service mariadb.service
Requires=redis-server.service

[Service]
User=pi
Group=www-data
UMask=0002
WorkingDirectory=/home/pi/admin-app
ExecStart=/usr/bin/php8.4 artisan queue:work redis --queue=default,media --sleep=3 --tries=3 --max-time=3600
Restart=always
RestartSec=5
StandardOutput=null
StandardError=journal

[Install]
WantedBy=multi-user.target
