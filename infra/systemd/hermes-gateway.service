[Unit]
Description=Hermes Agent Gateway
After=network-online.target
Wants=network-online.target
After=user@1000.service
Wants=user@1000.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=pi
Group=pi
ExecStart="/home/pi/.hermes/hermes-agent/.hermes/bin/hermes" "gateway" "run"
WorkingDirectory=/home/pi/.hermes
Environment="HOME=/home/pi"
Environment="USER=pi"
Environment="LOGNAME=pi"
Environment="PATH=/home/pi/.hermes/hermes-agent/node_modules/.bin:/home/pi/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="HERMES_HOME=/home/pi/.hermes"
Environment="HERMES_SUPERVISED_CHILD=1"
Restart=always
RestartSec=5
RestartForceExitStatus=75
SuccessExitStatus=75
RestartPreventExitStatus=78
KillMode=mixed
KillSignal=SIGTERM
ExecReload=/bin/kill -USR1 $MAINPID
ExecStop=-"/home/pi/.hermes/hermes-agent/.hermes/bin/hermes" "--run-module" "gateway.systemd_stop_mark"
ExecStopPost=-"/home/pi/.hermes/hermes-agent/.hermes/bin/hermes" "--run-module" "gateway.cgroup_cleanup"
TimeoutStopSec=210
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
